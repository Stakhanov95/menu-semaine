rules_version = '2';

// Règles de la base Firebase du « Menu de la semaine ».
// À coller dans la console Firebase : Firestore Database → Règles → Publier.
//
// Chaque foyer a un identifiant long et aléatoire (dans le lien partagé).
// Seuls les appareils connectés (connexion anonyme automatique de l'appli)
// qui connaissent cet identifiant peuvent lire et écrire ses deux documents.
// Personne ne peut lister les foyers existants.
service cloud.firestore {
  match /databases/{database}/documents {
    match /foyers/{foyerId}/donnees/{docId} {
      allow read: if request.auth != null
                  && foyerId.size() >= 20
                  && docId in ['semaine', 'coches'];
      allow write: if request.auth != null
                   && foyerId.size() >= 20
                   && docId in ['semaine', 'coches'];
    }
  }
}
